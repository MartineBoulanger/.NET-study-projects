@model Groente
@{
    ViewData["Title"] = Model.Naam;
}
<h1>@Model.Naam</h1>
<form method="post" asp-action="AfbeeldingToevoegen" asp-route-id="@Model.Id"
      enctype="multipart/form-data">
    
    <label>
        Afbeelding:
        <input type="file" name="bestand" required accept="image/png, image/jpeg"
               class="form-control-file"> 
    </label>
    <button type="submit" class="btn btn-primary">Opladen</button>
</form>

<img src="~/home/afbeelding/@Model.Id" alt="Afbeelding van @Model.Naam" />