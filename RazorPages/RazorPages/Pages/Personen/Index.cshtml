@page "/Personenlijst/{handler?}"
@model IndexModel
@{
    ViewData["Title"] = "Index";
}
<h1>Personenlijst</h1>
<form method="get" asp-page-handler="OnGet">
    <div class="input-group">
        <input class="form-control" asp-for="ZoekTerm" />
        <div class="input-group-append">
            <button class="btn btn-primary" type="submit">Search</button>
        </div>
    </div>
</form>
<div class="m-3">
    <a asp-page="Create">Create</a>
</div>
<table class="table">
    <thead>
        <tr>
            <th>ID</th>
            <th>Naam</th>
            <th>Geboortedatum</th>
            <th>Geslacht</th>
            <th>Gehuwd</th>
            <th>Opmerking</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var persoon in Model.Personen)
        {
            <tr>
                <td><a asp-page="Details" asp-route-id="@persoon.Id">@persoon.Id</a></td>
                <td>@persoon.Voornaam @persoon.Familienaam</td>
                <td>@persoon.Geboren.ToShortDateString()</td>
                <td>@persoon.Geslacht</td>
                <td>
                    <input @(persoon.Gehuwd ? "checked" : "") class="check-box" disabled="disabled" type="checkbox" />
                </td>
                <td>@persoon.Opmerkingen</td>
                <td>
                    <a asp-page="Edit" asp-route-id="@persoon.Id">Edit</a> | 
                    <a asp-page="Delete" asp-route-id="@persoon.Id">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>

@if (Model.Boodschap != null)
{
    <h5 class="alert alert-info mt-3">@Model.Boodschap</h5>
}
<form method="get" asp-page-handler="SendEmail">
    <div class="col-sm-5">
        <div class="input-group">
            <div class="input-group-prepend">
                <span class="input-group-text">@@</span>
            </div>
            <input asp-for="Email" type="text" class="form-control"
                   placeholder="Your emailaddress">
            <div class="input-group-append">
                <button class="btn btn-primary" type="submit">Send List</button>
            </div>
        </div>
    </div>
</form>
@if (Model.MailBoodschap != null)
{
    <h5 class="alert alert-info mt-3">@Model.MailBoodschap</h5>
}