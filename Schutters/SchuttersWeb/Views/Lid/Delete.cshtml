@model Lid
@{
    ViewData["Title"] = "Delete Lid";
}
@if (Model != null)
{
    <h1>Delete</h1>
    <h3>Lid</h3>
    <hr />
    <div>
        <dl class="row">
            <dt class="col-sm-2">Lidnr</dt>
            <dd class="col-sm-10">@Model.Lidnummer</dd>

            <dt class="col-sm-2">Naam</dt>
            <dd class="col-sm-10">@Model.Naam</dd>

            <dt class="col-sm-2">Voornaam</dt>
            <dd class="col-sm-10">@Model.Voornaam</dd>

            @if (Model.Geslacht != null)
            {
                <dt class="col-sm-2">Geslacht</dt>
                <dd class="col-sm-10">@Model.Geslacht</dd>
            }

            @if (Model.Niveau != null)
            {
                <dt class="col-sm-2">Niveau</dt>
                <dd class="col-sm-10">@Model.Niveau</dd>
            }

            <dt class="col-sm-2">Club</dt>
            <dd class="col-sm-10">@Model.Club?.Naam</dd>
        </dl>
        <p>Bent u zeker dat u dit lid wilt verwijderen?</p>
        <form asp-action="Delete">
            <input type="hidden" asp-for="Lidnummer" />
            <div class="form-buttons">
                <input type="submit" value="Delete" class="btn btn-danger" />
                <a asp-action="Index" class="btn btn-success">Terug Naar Lijst</a>
            </div>
        </form>
    </div>
}
else
{
    <p class="text-danger mb-3">@ViewBag.ErrorMessage</p>
    <a asp-action="Index" class="btn btn-success">Terug Naar Lijst</a>
}
