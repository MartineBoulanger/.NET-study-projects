@model Club
@{
    ViewData["Title"] = "Details Club";
}
@if (Model != null)
{
    <h1>Details</h1>
    <h3>Club</h3>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Stamnr</dt>
        <dd class="col-sm-10">@Model.Stamnummer</dd>

        <dt class="col-sm-2">Clubnaam</dt>
        <dd class="col-sm-10">@Model.Naam</dd>

        <dt class="col-sm-2">Postcode</dt>
        <dd class="col-sm-10">@Model.Postcode</dd>

        <dt class="col-sm-2">Gemeente</dt>
        <dd class="col-sm-10">@Model.Gemeente</dd>

        @if (Model.Adres != null)
        {
            <dt class="col-sm-2">Adres</dt>
            <dd class="col-sm-10">@Model.Adres</dd>
        }
    </dl>
    <div class="form-buttons">
        @if (User.IsInRole("Admin"))
        {
            <a asp-action="Edit" asp-route-id="@Model.Stamnummer" class="btn btn-primary">Edit</a>
        }
        <a asp-action="Index" class="btn btn-success">Terug Naar Lijst</a>
    </div>
}
else
{
    <p class="text-danger mb-3">@ViewBag.ErrorMessage</p>
    <a asp-action="Index" class="btn btn-success">Terug Naar Lijst</a>
}