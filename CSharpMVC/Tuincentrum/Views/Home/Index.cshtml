@* dit is om de translations te kunnen gebruiken -- gelijk de useTranslation hook in react *@
@using Microsoft.AspNetCore.Mvc.Localization
@using Tuincentrum.Resources
@inject IHtmlLocalizer<SharedResource> SharedLocalizer
@inject IViewLocalizer Localizer 
@{
    ViewData["Title"] = "Home Page";
}

<div class="jumbotron">
    @* <h1>@Localizer["Welkom"]</h1> *@
    @* <h1>@ViewBag.Welkomstekst</h1> *@
    <h1>@DateTime.Now.ToLongDateString()</h1>
    <p class="lead">
        De tuincentrum - website is een voorbeeld website uit de
        ASP .NET Core MVC cursus.
    </p>
    <p>
        <a href="https://learn.microsoft.com/en-us/aspnet/core" class="btn btn-primary btn-lg">Meer over MVC &raquo;</a>
    </p>
</div>

<div class ="row">
    <div class="col-md-4">
        <h2><a asp-action="Index" asp-controller="Plant">@SharedLocalizer["Planten"]</a></h2>
        <p>Overzicht van het plantenassortiment.</p>
    </div>
    <div class="col-md-4">
        <h2><a asp-action="Index" asp-controller="Soort">@SharedLocalizer["Soorten"]</a></h2>
        <p>Informatie over de diverse soorten planten.</p>
    </div>
    <div class="col-md-4"> 
        <h2><a asp-action="Index" asp-controller="Leverancier">@SharedLocalizer["Leveranciers"]</a></h2>
        <p>De leveranciersgegevens.</p>
    </div>
    <div class="col-md-4">
        <a asp-action="AllePlanten" class="btn btn-primary">Alle Planten</a>
        <a asp-action="PlantenVanEenLeverancier" asp-route-levnr="3" class="btn btn-primary">Plantenlijst van leverancier 3</a>
    </div>
    <div class="col-md-4"> 
        <a href="@Url.RouteUrl("AllePlanten")" class="btn btn-primary">Alle Planten</a>
        <a href="@Url.RouteUrl("PlantenVanEenLeverancier", new { levnr = 3 })" class="btn btn-primary">Plantenlijst van leverancier 3</a>
    </div>
</div>