@model IEnumerable<Plant>
@{
    ViewData["Title"] = "PrijsLijst";
}

<h1>PrijsLijst</h1>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Naam</th>
            <th>Verkoopprijs (BTW @ViewBag.Btw)</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Naam</td>
                <td>
                    @if (ViewBag.Btw == "inclusief")
                    {
                        decimal prijs = item.VerkoopPrijs * 1.21m;
                        @string.Format("{0:C}", prijs)
                    }
                    else @Html.DisplayFor(m => item.VerkoopPrijs)
                </td>
            </tr>
        }
    </tbody>
</table>