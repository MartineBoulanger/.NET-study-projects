} *@

@*oefening*@
@* @{
    int count = 12;
    int a = 0;
    int b = 1;
}
<ul>
    @for (int c = 0; c < count; c++)
    {
        <li>@a</li>
        int temp = a + b;
        a = b;
        b = temp;
    }
</ul> *@

@*of in een rij zoals in voorbeel oplossing*@
@* @{
    var i = 0;
    var j = 1;
    var tussen = 0;
    <h2>Rij van Fibonacci</h2>
    <p>
        @i, @j
        @while (tussen < 100)
        {
            tussen = i + j;
            if (tussen < 100)
            {
                @:, @tussen
            }
            i = j;
            j = tussen;
        }
    </p>
} *@

