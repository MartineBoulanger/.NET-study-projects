@model IdentityRole
@{
    ViewData["Title"] = "VerwijderRole";
}

<h1>@Model.Name verwijderen?</h1>
<form asp-action="VerwijderRoleDoorvoeren" asp-route-id="@Model.Id" method="post">
    <input type="submit" value="Delete" class="btn btn-danger"/>
    <a asp-action="rolebeheer" class ="btn btn-primary">Cancel</a>
</form>