@model Bier

@{
    ViewData["Title"] = "Toevoegen";
}

<h1>Bier Toevoegen</h1>

<form asp-action="Toevoegen" method="post">
    @* <label asp-for="Id"></label>
    <input asp-for="Id" readonly /> *@

    <label asp-for="Naam"></label>
    <span asp-validation-for="Naam">*</span>
    <input asp-for="Naam" />

    <label asp-for="Alcohol"></label>
    <span asp-validation-for="Alcohol">*</span>
    <input asp-for="Alcohol" />

    <label asp-for="Prijs"></label>
    <input asp-for="Prijs" />

    <input type="submit" value="Toevoegen" />

    <div asp-validation-summary="All"></div>
</form>