<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["lib/bootstrap/dist/css/bootstrap.min.css"]" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["BlazorAuto.styles.css"]" />
    <ImportMap />
    <link rel="icon" type="image/png" href="favicon.png" />
    <HeadOutlet @rendermode="InteractiveAuto" />
    <script>
        kwadraat = getal => getal**2;
        setElementText = (element, text) => element.innerText = text;
        userInputFunctions = {
            vraagNaam: function (text) {
                return prompt(text, 'Tik hier jouw naam');
            },
            toonBoodschap: function (boodschap) {
                document.getElementById('welkomstTekst').innerText = boodschap;
            },
            zetdefocus: function () {
                document.getElementById('getal').focus();
            }
        };
        returnPersonenlijstJs = function () {
            DotNet.invokeMethodAsync('BlazorAuto.Client', 'GetPersonen').then(data => {
                    const tbody = document.querySelector("tbody");
                    for ( let teller = 0; teller < data.length; ++teller) {
                        const tr = tbody.insertRow();
                        const idTd = tr.insertCell();
                        idTd.innerText = data[teller].id;
                        const voornaamTd = tr.insertCell();
                        voornaamTd.innerText = data[teller].voornaam;
                        const famnaamTd = tr.insertCell();
                        famnaamTd.innerText = data[teller].familienaam;
                    }
                }
            );
        };
        callGroeter = function (objectReference) {
            return objectReference.invokeMethodAsync('Begroet').then(r => {
                const p = document.querySelector("#boodschap");
                p.innerText = r;
            });
        };
    </script>
</head>

<body>
    <Routes @rendermode="InteractiveAuto" />
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>
