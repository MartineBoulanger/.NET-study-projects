<div class="alert alert-info">
    <p>@Doelgroep - @Cursus</p>
    <p>&copy; @Auteur (@Jaartal)</p>
    @ChildContent
</div>

@code {
    [Parameter, EditorRequired]
    public string Auteur { get; set; }

    [Parameter]
    public string? Cursus { get; set; }

    [Parameter]
    public string? Doelgroep { get; set; }

    [Parameter]
    public int Jaartal { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    public string AlleInfo()
    {
        return $" {Auteur} {Cursus} {Jaartal} {Doelgroep} ";
    }
}