@page "/todo"
@inject Blazored.LocalStorage.ILocalStorageService localStore

<h3 >TodoList</h3>

<label for="todo" class="form-label">Nieuwe taak</label>
<input id="todo" @bind="nieuweTodo" type="text" class="form-control" />
<button class="btn btn-primary my-3" @onclick="SaveTodoAsync">Save</button>
@foreach ( var taak in todos) {
<p><img src="images/delete.png" class="me-2" @onclick="() => DeleteTodoAsync(taak)"/>@taak</p>
}

@code {
    private string? nieuweTodo;
    private List<string> todos = new List<string>();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            todos = await localStore.GetItemAsync<List<string>>("todos") ?? todos;
            StateHasChanged();
        }
    }

    public async Task SaveTodoAsync()
    {
        if (nieuweTodo is not null && nieuweTodo != string.Empty)
        {
            todos.Add(nieuweTodo);
            nieuweTodo = string.Empty;
            await localStore.SetItemAsync("todos", todos);
        }
    }

    public async Task DeleteTodoAsync(string taak)
    {
        todos.Remove(taak);
        await localStore.SetItemAsync("todos", todos);
    }
}
