@page "/counter"
@inject Blazored.SessionStorage.ISessionStorageService sessionStore
@inject IJSRuntime JSRuntime

<NavigationLock ConfirmExternalNavigation OnBeforeInternalNavigation="OnBeforeInternalNavigation" />

<PageTitle>Counter</PageTitle>

<h1>Counter</h1>

<p role="status">Current count: @currentCount</p>

<button class="btn btn-primary" @onclick="IncrementCountAsync">Click me</button>

@code {
    private int currentCount = 0;

    private async Task IncrementCountAsync()
    {
        currentCount++;
        await sessionStore.SetItemAsync("counter", currentCount);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            int? sessionCounter = await sessionStore.GetItemAsync<int>("counter");
            if (sessionCounter == null)
                currentCount = 0;
            else
                currentCount = (int)sessionCounter;
            StateHasChanged();
        }
    }

    private async Task OnBeforeInternalNavigation(LocationChangingContext context)
    {
        var doorgaan = await JSRuntime.InvokeAsync<bool>("confirm", "Weet je zeker dat je de pagina wil verlaten?");
        if (!doorgaan) context.PreventNavigation();
    }
}
