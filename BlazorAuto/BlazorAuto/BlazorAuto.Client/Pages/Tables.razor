@page "/tables"

<TableTemplate TItem="Boek" Items="boeken" Context="boek">
    <TableHeader><h1>Boekenlijst</h1></TableHeader>
    <RowTemplate>
        <div class="links">
            <img src="/images/@boek.Afbeelding" alt="@boek.Titel" height="200" width="140" />
        </div>
        <div class="rechts">
            <h2>@boek.Auteur</h2>
            <h3>@boek.Titel</h3>
            <p>@boek.Taal | @boek.Afwerking | @boek.ISBN | @boek.UitgifteDatum</p>
            <p>@boek.Beschrijving</p>
        </div>
    </RowTemplate>
</TableTemplate>


<TableTemplate TItem="Artikel" Items="artikels" Context="artikel">
    <TableHeader>
        <th>Id</th>
        <th>Naam</th>
        <th>Prijs</th>
        <th>Omschrijving</th>
    </TableHeader>
    <RowTemplate>
        <td>@artikel.Id</td>
        <td>@artikel.Naam</td>
        <td>@artikel.Prijs</td>
        <td>@artikel.Omschrijving</td>
    </RowTemplate>
    <TableFooter>
        &copy; VDAB 2026
    </TableFooter>
</TableTemplate>

<TableTemplate TItem="Persoon" Items="personen" Context="persoon">
    <TableHeader>
        <th>Id</th>
        <th>Voornaam</th>
        <th>Familiesnaam</th>
    </TableHeader>
    <RowTemplate>
        <td>@persoon.Id</td>
        <td>@persoon.Voornaam</td>
        <td>@persoon.Familienaam</td>
    </RowTemplate>
</TableTemplate>

