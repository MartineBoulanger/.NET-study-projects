@page "/ranking-list"
@inject PlayersService playerService

<PageTitle>Ranking List</PageTitle>

<h1 class="mb-3">Ranking List</h1>

@if (Players != null)
{
    <QuickGrid Items="Players" TGridItem="Player" Virtualize="true" Pagination="pagination" class="table">
        <TemplateColumn>
            <a href="@($"/players/edit/{@context.PlayerId}")" class="btn btn-primary mb-0.5">Edit</a>
        </TemplateColumn>
        <PropertyColumn Property="@(p => p.Name + " " + $"({p.CountryCode})")" Sortable="false" Title="Player" />
        <PropertyColumn Property="@(p => p.Points)" Sortable="false" />
    </QuickGrid>
    <Paginator State="pagination" />
}
else
{
    <p class="if(Players is null ? text-bg-info : text-bg-danger) p-3">@boodschap</p>
}

@code {
    public IQueryable<Player>? Players { get; set; }
    private string boodschap = "Retrieving players...";

    protected override async Task OnInitializedAsync()
    {
        var players = await playerService.GetPlayersAsync();
        if (players != null)
            Players = players.AsQueryable();
        else
            boodschap = "Database error...";
    }

    private new PaginationState pagination = new PaginationState { ItemsPerPage = 10 };
}
