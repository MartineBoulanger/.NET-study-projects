@model IEnumerable<UitleenobjectDetailViewModel>
@{
    ViewData["Title"] = "Index";
}

<h1>Uitleenobjecten</h1>
@if (Model == null || Model.Count() == 0)
{
    <h2>Er zijn geen uitleenobjecten geregistreerd</h2>
}
else
{
    <table class="table table-bordered">
        <thead>
            <tr>
                <th></th>
                <th>Naam</th>
                <th>Kostprijs</th>
                <th>Jaar</th>
                <th>Status</th>
                <th>Details</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td><a asp-action="Detail" asp-route-id="@item.Id">@item.Id</a></td>
                    <td>@item.Type @item.Naam</td>
                    <td>@item.Kostprijs.ToString("€ #,##0.00")</td>
                    <td>@item.Jaar</td>
                    <td>@item.Status</td>
                    <td>@item.Details</td>
                </tr>
            }
        </tbody>
    </table>
}